---
import type { Project } from '../data/projects';
interface Props { project: Project; index: number }
const { project, index } = Astro.props;
---
<article class="project-card">
  <div class="card-meta"><span>{String(index + 1).padStart(2, '0')}</span><span>{project.area}</span></div>
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  <div class="tags">{project.technologies.map(t => <span>{t}</span>)}</div>
  <div class="card-footer"><small>{project.status}</small>{project.page ? <a class="project-page" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${project.page}`} aria-label={`Ver proyecto: ${project.name}`}>Ver proyecto →</a> : project.url ? <a href={project.url}>Ver repositorio ↗</a> : <small>Documentación próximamente</small>}</div>
</article>

<style>
  .project-card { position: relative; }
  .project-page::after { content: ''; position: absolute; inset: 0; border-radius: 10px; }
  .project-card:focus-within { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
