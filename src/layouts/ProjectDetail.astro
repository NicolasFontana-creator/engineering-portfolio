---
import BaseLayout from './BaseLayout.astro';
interface Props { frontmatter: { title: string; description: string } }
const { title, description } = Astro.props.frontmatter;
const projects = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/#projects`;
---
<BaseLayout title={`${title} | Engineering-Portfolio`} description={description}>
  <main class="container detail">
    <nav aria-label="Volver al portfolio"><a href={projects}>← Proyectos seleccionados</a></nav>
    <article>
      <h1>{title}</h1>
      <slot />
    </article>
    <a href={projects}>← Volver a proyectos</a>
  </main>
</BaseLayout>

<style>
  .detail { max-width: 54rem; padding-block: 2rem 4rem; }
  .detail h1 { font-size: clamp(2.1rem, 6vw, 3.7rem); }
  article { margin-block: 3rem; }
  .detail :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
  article :global(h2) { border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 3rem; font-size: clamp(1.6rem, 4vw, 2.3rem); }
  article :global(h3) { margin-top: 2rem; }
  article :global(img) { display: block; width: auto; max-width: 100%; height: auto; margin: 1.5rem auto; }
  article :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 1.5rem; }
  article :global(th), article :global(td) { padding: .7rem; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  article :global(th) { background: var(--panel); }
  article :global(code) { overflow-wrap: anywhere; }
</style>
