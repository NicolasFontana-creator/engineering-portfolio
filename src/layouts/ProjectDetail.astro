---
import BaseLayout from './BaseLayout.astro';
interface Props {
  frontmatter: {
    title: string;
    description: string;
    lang: 'es' | 'en';
    alternatePath: string;
    repository: string;
    collection?: 'coursework';
  };
}
const { title, description, lang, alternatePath, repository, collection } = Astro.props.frontmatter;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coursework = collection === 'coursework';
const projects = `${base}/#${coursework ? 'coursework' : 'projects'}`;
const alternate = `${base}/${alternatePath}`;
const english = lang === 'en';
const backLabel = english ? '← Academic Coursework' : '← Trabajos Universitarios';
const otherLang = english ? 'es' : 'en';
---
<BaseLayout title={`${title} | Engineering-Portfolio`} description={description} lang={lang}>
  <Fragment slot="head">
    <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={otherLang} href={new URL(alternate, Astro.site)} />
  </Fragment>
  <main class="container detail">
    <nav class="detail-nav" aria-label={english ? 'Project navigation' : 'Navegación del proyecto'}>
      <a href={projects}>{coursework ? backLabel : english ? '← Portfolio projects (Spanish)' : '← Proyectos seleccionados'}</a>
      <a href={alternate} lang={otherLang} hreflang={otherLang}>{english ? 'Español' : 'English'}</a>
    </nav>
    <article>
      <h1>{title}</h1>
      <a href={repository}>{english ? 'View project on GitHub' : 'Ver proyecto en GitHub'}</a>
      <slot />
    </article>
    <a href={projects}>{coursework ? backLabel : english ? '← Back to projects (Spanish)' : '← Volver a proyectos'}</a>
  </main>
</BaseLayout>

<style>
  .detail-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; }
  .detail { max-width: 54rem; padding-block: 2rem 4rem; }
  .detail h1 { font-size: clamp(2.1rem, 6vw, 3.7rem); }
  article { margin-block: 3rem; }
  .detail :global(a) { color: var(--accent); text-decoration: underline; text-underline-offset: .18em; }
  article :global(h2) { border-top: 1px solid var(--line); padding-top: 1.5rem; margin-top: 3rem; font-size: clamp(1.6rem, 4vw, 2.3rem); }
  article :global(h3) { margin-top: 2rem; }
  article :global(img) { display: block; width: auto; max-width: 100%; height: auto; margin: 1.5rem auto; }
  article :global(.table-scroll) { max-width: 100%; overflow-x: auto; margin-block: 1.5rem; }
  article :global(.table-scroll:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  article :global(table) { border-collapse: collapse; }
  article :global(th), article :global(td) { padding: .7rem; border: 1px solid var(--line); text-align: left; vertical-align: top; }
  article :global(th) { background: var(--panel); }
  article :global(code) { overflow-wrap: anywhere; }
</style>
